#include <iostream>
#include<stdio.h>
int main()
{
int xz[4][4] = {{0, 0, 1, 0},{0, 0, 1, 0},{0, 0, 2, 1},{1, 3, 3, 3}};
    int xy[4][4] = { {0,0,0,0},{ 0,1,2,1 },{1,1,4,1},{0,1,1,2}};
        int total = 0;
        double sumX = 0, sumY = 0, sumZ = 0;
        for (int x = 0; x < 4; x++) {
            for (int y = 0; y < 4; y++) {
                int ZmaX = xy[y][x];
                for (int z = 0; z < ZmaX ; z++) {
                    total++;
                    sumX += x + 1;
                    sumY += y + 1;
                    sumZ += z + 1;
                }
            }
        }

        printf("重心 X = %.2f\n", sumX / total);
        printf("重心 Y = %.2f\n", sumY / total);
        printf("重心 Z = %.2f\n", sumZ / total);
 return 0;
    }
